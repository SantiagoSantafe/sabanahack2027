{
  "name": "berry-sim",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:api": "cd sim-core && .venv/bin/uvicorn server:app --reload --host 0.0.0.0 --port 8000",
    "test": "cd sim-core && .venv/bin/pytest -q",
    "batch": "cd sim-core && .venv/bin/python batch.py --runs 200 --alternatives all --year 2025",
    "fetch-d1": "bash scripts/fetch_d1_urdf.sh"
  }
}
